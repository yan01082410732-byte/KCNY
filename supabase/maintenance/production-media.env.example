# Server configuration only. Never override provider-injected SUPABASE_* secrets.
# Vercel Production app: NEXT_PUBLIC_SUPABASE_URL must be the exact production URL.
KCNY_MEDIA_ENVIRONMENT=production
KCNY_MEDIA_DEPLOYMENT_ENV=production
KCNY_POST_IMAGES_ENABLED=false
# Database media_private.configuration.enabled remains false independently.
# Vercel supplies VERCEL_ENV=production; Preview must never inherit this combination.
# Both Edge functions use the first two variables and provider SUPABASE_URL.
# Maintenance HMAC is generated in project-local Vault, not stored in this file.
