NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default OFF until current quota and traffic budget approve periodic unread reads.
# Focus/visibility/read invalidations still re-read authenticated counts.
NEXT_PUBLIC_KCNY_NOTIFICATION_POLLING_ENABLED=false

# Reporting remains disabled until separate production approval and DB gates.
KCNY_REPORTS_ENABLED=false
KCNY_REPORTING_OPERATIONS_ENABLED=false
# Separate self-confirmation only; never grants a reviewer role.
KCNY_REVIEWER_BINDING_ENABLED=false
# Private random base64url key (at least32 bytes), supplied only via secure server config.
# KCNY_REVIEWER_BINDING_SECRET=
